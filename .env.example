# AWS
AWS_REGION=us-east-1
# Leave blank for real AWS. Set to http://localhost:4566 to target LocalStack.
AWS_ENDPOINT_URL=

# S3
S3_BUCKET_NAME=ai-vet-triage-media-dev
PRESIGNED_URL_EXPIRY_SECONDS=900

# DynamoDB
DYNAMODB_TABLE_NAME=vet-triage

# SQS
SQS_QUEUE_NAME=vet-triage-processing
SQS_DLQ_NAME=vet-triage-processing-dlq
SQS_MAX_RECEIVE_COUNT=3
SQS_VISIBILITY_TIMEOUT_SECONDS=300

# Google Gemini (multimodal video/audio triage — replaces the old OpenAI
# Whisper + GPT-4o pipeline; Gemini's flash model processes video frames and
# the audio track natively in one call, no separate transcription/frame-extraction
# step). Comma-separated so a quota-exhausted key rotates to the next one
# automatically instead of failing the case — see app/services/ai/gemini_client.py.
# GEMINI_MODEL uses the "-latest" alias rather than a pinned version like
# "gemini-1.5-flash" — Google retires model generations over time, and a
# pinned version starts returning 404 model-not-found once that happens
# (confirmed against live keys during this project's development).
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-flash-latest

# Redis (WebSocket fan-out). Leave blank to disable real-time push gracefully.
REDIS_URL=redis://localhost:6379/0
REDIS_TRIAGE_UPDATES_CHANNEL=triage-updates
